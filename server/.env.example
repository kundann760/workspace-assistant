# ──────────────────────────────────────────────────────────────
# Server environment variables. Copy this file to `.env` and fill in values.
# NEVER commit your real `.env` file or your service-account JSON file.
# ──────────────────────────────────────────────────────────────

# Port the API listens on.
PORT=8080

# Firebase project ID (Firebase console → Project settings → General → Project ID).
FIREBASE_PROJECT_ID=your-firebase-project-id

# Service-account key that lets the server read/write Firestore and verify sign-ins.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Save the downloaded file as server/service-account.json (this path is relative to the server folder).
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# For hosting (Render etc.) instead of a file: the same JSON, base64-encoded on one line.
# Leave empty for local development.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Google AI Studio API key (https://aistudio.google.com/apikey). Free, no card.
GEMINI_API_KEY=your-gemini-api-key

# Models (change if Google renames/retires them — see https://ai.google.dev/gemini-api/docs/models).
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Optional: Slack or Discord incoming webhook URL used by the `send_notification` tool.
# Leave empty to disable that tool (the assistant will say it isn't configured).
NOTIFY_WEBHOOK_URL=

# Retrieval tuning (optional).
RAG_TOP_K=6
RAG_CANDIDATES=25
RAG_MIN_SIMILARITY=0.45
MAX_TOOL_STEPS=5
