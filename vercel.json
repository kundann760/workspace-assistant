{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix server --include=dev && npm install --prefix client --include=dev",
  "buildCommand": "npm run build --prefix server && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/dist/**,server/sample-docs/**,server/node_modules/pdf-parse/lib/pdf.js/v1.10.100/**}"
    }
  },
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://workspace-18c8b.firebaseapp.com/__/auth/:path*" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
